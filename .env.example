# ===== Backend (server) =====

# MongoDB connection string (required for backend)
MONGODB_URI=mongodb://localhost:27017/adaptime

# Server port (default: 3001)
PORT=3001

# JWT secret for auth tokens.
# PRODUCTION'DA MUTLAKA değiştir ve gerçek bir rastgele değer ver.
JWT_SECRET=your-secret-key-here

# Firebase Auth — Google ile giriş için.
# https://console.firebase.google.com → Project settings → General → Your apps → Web app
# "Firebase project ID" değeri (proje ayarlarında görünür).
# Boş bırakılırsa Google ile giriş devre dışı kalır (demo login çalışır).
FIREBASE_PROJECT_ID=

# CORS: virgülle ayrılmış allowed origin listesi (Vite dev + prod domain)
# Boş bırakılırsa localhost:5173 ve 4173 kabul edilir.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== AI (Gemini, free tier) =====
# Anahtarlarını BURAYA yaz (ASLA frontend'e koyma). İki biçim desteklenir:
#
# 1) JSON array:
#    GEMINI_API_KEYS=["AIza...key1","AIza...key2"]
#
# 2) Numaralı değişkenler (istediğin kadar, 1-10):
#    GEMINI_API_KEY_1=AIza...key1
#    GEMINI_API_KEY_2=AIza...key2
#    GEMINI_API_KEY_3=AIza...key3
#    GEMINI_API_KEY_4=AIza...key4
#
# Boş bırakılırsa AI kapalı kalır; mentor kural tabanlı mesajlarla çalışmaya devam eder.
# Kota (429) alan anahtar otomatik devre dışı kalır ve sıradaki anahtar denenir.
GEMINI_API_KEYS=["","","",""]
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Model (tek yerden değiştirilir). Ücretsiz katman modeli.
GEMINI_MODEL=gemini-3.5-flash-lite
# Model bulunamazsa (404) denenecek ücretsiz yedek model(ler); kota dolduğunda kullanılmaz.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# ===== Frontend (Vite) =====

# Frontend API URL (used by Vite dev server when NOT using the dev proxy)
VITE_API_URL=http://localhost:3001

# Firebase client config — Firebase console'daki "Web app" yapılandırmasından kopyala.
# Bunlar PUBLIC değerlerdir; güvenlik açığı oluşturmaz.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ===== Harici cron (Render uykusuna karsi) =====
# Render ucretsiz servis uyurken sunucu icindeki setInterval de durur.
# GitHub Actions / cron-job.org her 10 dk'da bir su uca POST atmali:
#   POST https://<api-domain>/api/cron/tick
#   header: x-cron-secret: <CRON_SECRET>
# Bos birakilirsa uc tamamen kapalidir (401).
CRON_SECRET=

# Not: Sunucu once veritabanindaki (AppConfig "vapid") cifti kullanir.
# .env yalnizca veritabani bosken tohum olur; ayni cifti paylasmak icin
# veritabanindaki anahtarlari yaz veya bos birak.
