# ===== Backend (server) =====

# MongoDB connection string (required for backend)
MONGODB_URI=mongodb://localhost:27017/adaptime

# Server port (default: 3001)
PORT=3001

# JWT secret for auth tokens.
# PRODUCTION'DA MUTLAKA değiştir ve gerçek bir rastgele değer ver.
JWT_SECRET=your-secret-key-here

# Firebase Auth — Google ile giriş için.
# https://console.firebase.google.com → Project settings → General → Your apps → Web app
# "Firebase project ID" değeri (proje ayarlarında görünür).
# Boş bırakılırsa Google ile giriş devre dışı kalır (demo login çalışır).
FIREBASE_PROJECT_ID=

# CORS: virgülle ayrılmış allowed origin listesi (Vite dev + prod domain)
# Boş bırakılırsa localhost:5173 ve 4173 kabul edilir.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Gemini API keys for AI routine generation (JSON array - falls back to demo mode if empty)
# Birden fazla key kullanılabilir, biri kota hatası verince diğerine geçer.
GEMINI_API_KEYS=[]

# ===== Frontend (Vite) =====

# Frontend API URL (used by Vite dev server when NOT using the dev proxy)
VITE_API_URL=http://localhost:3001

# Firebase client config — Firebase console'daki "Web app" yapılandırmasından kopyala.
# Bunlar PUBLIC değerlerdir; güvenlik açığı oluşturmaz.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=